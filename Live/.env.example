# Stock Visualizer Live environment example
# Copy this file to .env for local development.
# Never commit your real .env file.

# ---------------------------------------------------------------------
# Market data provider
# ---------------------------------------------------------------------
# Supported now:
#   ibkr - Interactive Brokers wrapper around RealTimeIB
#   csv  - local CSV/parquet-style replay/cache provider
#
# Planned:
#   tradier
#   alpaca
#   tiingo
#   polygon
MARKET_DATA_PROVIDER=ibkr

# Local data root for CSV/local provider mode.
# This should point to your local replay/cache data folder.
CSV_MARKET_DATA_ROOT=cache/replay

# ---------------------------------------------------------------------
# Broker mode
# ---------------------------------------------------------------------
# Keep paper as the safe default.
BROKER_PROVIDER=paper
LIVE_TRADING_ENABLED=false

# ---------------------------------------------------------------------
# IBKR settings
# ---------------------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=

# ---------------------------------------------------------------------
# Future Tradier settings
# ---------------------------------------------------------------------
TRADIER_ENV=sandbox
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=

# ---------------------------------------------------------------------
# Future LLM settings
# ---------------------------------------------------------------------
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=60
# =============================================================================
# Future AI feature locks
# =============================================================================
# Keep AI disabled until the app has a reviewed AI service layer.
AI_FEATURES_ENABLED=false

# AI should be advisory-only. It should explain, summarize, and suggest.
# It should not place orders.
AI_ADVISORY_ONLY=true

# Hard safety locks. Keep these false until explicit broker-safety code exists.
AI_ALLOW_ORDER_PLACEMENT=false
AI_ALLOW_BROKER_ACCESS=false
AI_ALLOW_EXTERNAL_TOOLS=false

# Even when AI tools are added, require a human click/confirmation first.
AI_REQUIRE_HUMAN_CONFIRMATION=true

# Optional future model settings. Do not commit real API keys.
LLM_PROVIDER=none
LLM_BASE_URL=
OPENAI_API_KEY=

# Future AI safety locks
# Advisory LLM provider scaffold
LLM_MAX_INPUT_CHARS=8000

# LLM compatibility controls
LLM_CHAT_TOKEN_PARAM=auto
LLM_SEND_TEMPERATURE=auto

# =============================================================================
# LLM runtime diagnostics defaults
# =============================================================================
LLM_MAX_REQUESTS_PER_MINUTE=5
LLM_MAX_TOKENS_PER_MINUTE=25000
LLM_MAX_OUTPUT_TOKENS=500

# IDE/runtime local env loading
# Copy these to a local .env or Live/.env file. Do not commit real secrets.
LLM_MODEL=gpt-5.4-nano
# AI advisor defaults
AI_ADVISOR_MAX_CONTEXT_CHARS=6000
AI_ADVISOR_MAX_OUTPUT_TOKENS=500
# Research / Newsroom
RESEARCH_NEWS_ENABLED=true
RESEARCH_NEWS_FETCH_TIMEOUT_SECONDS=10
RESEARCH_NEWS_ITEMS_PER_FEED=3

# Research-aware AI context
AI_RESEARCH_CONTEXT_ENABLED=true
AI_RESEARCH_INCLUDE_NEWS_DEFAULT=false
AI_RESEARCH_MAX_CONTEXT_CHARS=12000
