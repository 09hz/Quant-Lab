# AlgoTrader optional PostgreSQL configuration.
# Copy to .env.local only if you use your own loader.
# Do not commit real passwords.

ALGOTRADER_DB_BACKEND=postgres
ALGOTRADER_DB_HOST=localhost
ALGOTRADER_DB_PORT=5432
ALGOTRADER_DB_NAME=algotrader
ALGOTRADER_DB_USER=algotrader_app
ALGOTRADER_DB_SCHEMA=algotrader

# Do not commit real passwords.
# Prefer setting this at runtime:
# $env:ALGOTRADER_DB_PASSWORD = Read-Host "Enter algotrader_app password"
# ALGOTRADER_DB_PASSWORD=
